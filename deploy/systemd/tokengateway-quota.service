[Unit]
Description=TokenGateway read-only LiteLLM quota dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=litellm
Group=litellm
WorkingDirectory=/opt/tokengateway-quota/dashboard
ExecStart=/usr/bin/bun /opt/tokengateway-quota/dashboard/server.ts
Environment=HOST=0.0.0.0
Environment=PORT=3737
Environment=LITELLM_CHATGPT_AUTH_FILE=/var/lib/litellm/chatgpt-local/auth.json
LoadCredential=dashboard-password:/etc/tokengateway/dashboard-password
Environment=DASHBOARD_PASSWORD_FILE=%d/dashboard-password
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/litellm/chatgpt-local
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
