# ==============================================================================
# LLM Quota Dashboard & LiteLLM Gateway
# Environment Configuration Template
# ==============================================================================

# --- General Settings ---
PORT=3737
HOST=0.0.0.0
# Required for all dashboard routes. Browser login: quota / this password.
# Generate with: openssl rand -hex 24
DASHBOARD_PASSWORD=
# Prefer a private file for systemd deployments:
# DASHBOARD_PASSWORD_FILE=/etc/tokengateway/dashboard-password
# Read-only quota mode: LiteLLM remains the sole OAuth refresh owner.
# LITELLM_CHATGPT_AUTH_FILE=/var/lib/litellm/chatgpt-local/auth.json
NODE_ENV=production
CREDENTIALS_PATH=./data/credentials.json
# Optional managed Claude beside read-only native ChatGPT quotas:
# MANAGED_ANTHROPIC=1
# CREDENTIALS_REQUIRE_DURABLE=1
# ANTHROPIC_PROXY_KEY_FILE=/etc/tokengateway/anthropic-proxy-key

# --- LiteLLM Proxy Settings ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-change-me-use-a-random-value

# --- OAuth Public Client Credentials (Defaults to First-Party CLI Clients) ---
# Anthropic Claude Code Client ID
ANTHROPIC_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e

# OpenAI Codex / ChatGPT Client ID
OPENAI_CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# Google Antigravity Cloud Code Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Optional Integrations ---
# Local vLLM Prometheus metrics endpoint
VLLM_METRICS_URL=http://localhost:8000/metrics

# Uptime Kuma monitoring URL
# UPTIME_KUMA_URL=http://localhost:3001
# UPTIME_KUMA_USERNAME=admin
# UPTIME_KUMA_PASSWORD=password

# Autonomous agents card. Unset both URLs to hide the card entirely.
# A2A_INFRA_AGENTS_URL=http://localhost:8080
# OPENHANDS_URL=http://localhost:3000
# OPENHANDS_API_KEY=

# Agent roster rendered in the card: JSON array of { name, role, detail }.
# A2A_AGENT_ROSTER=[{"name":"Infra Sentinel","role":"SRE","detail":"hourly drift audit"}]

# Optional cluster counters shown in the card; omitted when unset.
# CLUSTER_NODE_COUNT=
# CLUSTER_VM_COUNT=
